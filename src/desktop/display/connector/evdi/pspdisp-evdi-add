#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
#
# pspdisp-evdi-add - Load EVDI if needed and create an EVDI device for the PSPdisp daemon (Linux)
#
# Copyright © 2026 Arthur Neto
#
# The daemon runs as the user, but only root can load the EVDI module and create an EVDI device (a virtual display), so the daemon runs this through pkexec when it can't open a device.
# Without the module, libevdi finds no device and can't create one either, so this loads the module first, then creates a device if loading it didn't.
# Then it waits for udev, so the user can open the new card.
# polkit asks for the password first (see com.pspdisp.evdi-add.policy.in), both are installed by `make install`.
# It takes no arguments and only loads EVDI and creates one device, so it can't be used for anything else.

set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin

if [ -e /sys/devices/evdi/add ]; then
    # The module is loaded, try to add a device
    echo 1 > /sys/devices/evdi/add
else
    # The module isn't loaded (it creates /sys/devices/evdi), with its options of /etc/modprobe.d
    modprobe evdi
    # The module creates the devices of its initial_device_count option, and if none was created, then we have to create one
    if [ "$(cat /sys/devices/evdi/count)" -eq 0 ]; then
        echo 1 > /sys/devices/evdi/add
    fi
fi

# udev gives the new card to the user at the computer (the uaccess ACL), so wait for it before the daemon opens the card
udevadm settle --timeout=5 || true
