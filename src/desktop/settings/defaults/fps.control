; A sample control file that can be used to control a
; typical first person shooter game.
;
; Movement controls:
; square = A
; cross = S
; triangle = W
; circle = D
;
; left trigger = right mouse click
; right trigger = left mouse click
; analog stick = mouse control
;
; DPAD up = spacebar (jump)
; DPAD down = left ctrl (crouch)
; DAPD left = mouse wheel down (previous weapon)
; DPAD right = mouse wheel up (next weapon)
;
; START = unassigned
; SELECT = unassigned

[Info]
Version=0.6.0.0

[General]
Name=Generic FPS
MapAnalogToDPad=0
AnalogDeadZone=60
EnableOSK=0

[AnalogStickMapping]
Section1=1
Section2=2
Section3=3
Section4=5
Section5=6
Maximum=7


